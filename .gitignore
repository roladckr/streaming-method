# ---- Node / n8n ----
node_modules/
dist/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.n8n/

# ---- Environment variables / secrets ----
# NEVER commit credentials, tokens, or API keys
.env
.env.*
!.env.example
credentials.json
token.json
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*.pyc
.venv/
venv/
env/
.ipynb_checkpoints/
*.egg-info/

# ---- Large data files ----
# Test spreadsheets stay local: GitHub rejects files larger than 100 MB
# Local/company spreadsheet data
data/
local_data/

# Spreadsheet files are ignored by default
*.xlsx*
~$*.xlsx

# Allow committed synthetic test fixtures
!tests/fixtures/*.xlsx
*.csv
*.parquet

# ---- Office temporary files ----
~$*.xlsx
~$*.docx
~$*.pptx

# ---- Operating system ----
Thumbs.db
desktop.ini
.DS_Store

# ---- Editors ----
.vscode/
.idea/
*.swp

# ---- Local-only diagnostic scripts ----
# Temporary dev scripts at the repo root, not part of the repo test
# suite. Anchored to the root (leading /) so these patterns don't
# also match same-named files under tests/ - tests/test_xlsx_stream.py
# is a real, committed part of the test suite and must not be ignored.
/inspect_b2s_headers.py
/test_c2_batch.py
/test_xlsx_stream.py

# ---- Test fixtures (exception) ----
# Small, synthetic XLSX fixtures under tests/fixtures/ ARE committed.
# data/ and local_data/ (real/company spreadsheets) stay fully ignored.
!tests/fixtures/*.xlsx

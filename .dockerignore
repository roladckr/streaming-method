# Keep the build context small and make sure nothing sensitive or
# unnecessary ever reaches the Docker daemon, even though the
# Dockerfile only ever COPYs requirements.txt and src/.

.git/
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/

# Company/local spreadsheet data - never goes into the image.
data/
local_data/
*.xlsx
*.xlsx*
!tests/fixtures/*.xlsx

# Secrets - never goes into the image.
.env
.env.*
!.env.example
credentials.json
token.json
*.pem
*.key

# Not needed at runtime.
tests/
docs/
README.md
CONTRIBUTING.md
.pytest_cache/
.DS_Store
